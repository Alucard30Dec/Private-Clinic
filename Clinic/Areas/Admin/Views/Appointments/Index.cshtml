@using System.Collections.Generic
@model IEnumerable<Clinic.Models.Appointment>

@{
    ViewBag.Title = "Lịch hẹn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var routeName = "Admin_Appointments_actions";
    var q = Request["q"];

    // Link tạo mới
    var createHref = Url.RouteUrl(routeName, new { action = "Create" })
                   ?? Url.Action("Create", "Appointments", new { area = "Admin" });

    // Kiểm tra có dữ liệu
    bool hasData = false;
    if (Model != null)
    {
        var col = Model as ICollection<Clinic.Models.Appointment>;
        if (col != null) { hasData = col.Count > 0; }
        else { foreach (var _ in Model) { hasData = true; break; } }
    }
}

<div class="container-fluid py-3">
    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["warn"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["warn"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between mb-3 align-items-center">
        <h2 class="mb-0">Danh sách lịch hẹn</h2>

        <div class="d-flex gap-2">
            <form method="get" class="d-flex" role="search">
                <input name="q" value="@q" class="form-control" placeholder="Tìm theo bệnh nhân/bác sĩ/dịch vụ" />
                <button class="btn btn-primary ms-2" type="submit">Tìm</button>
            </form>
            <a class="btn btn-success" href="@createHref">Tạo lịch hẹn</a>
        </div>
    </div>

    @{
        if (!hasData)
        {
            <div class="text-muted fst-italic">
                Chưa có lịch hẹn. Hãy bấm <a href="@createHref">Tạo mới</a>.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:72px">#</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                            <th>Bệnh nhân</th>
                            <th>Bác sĩ</th>
                            <th>Dịch vụ</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width:1%; white-space:nowrap;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1; }
                        @foreach (var a in Model)
                        {
                            var editHref = Url.RouteUrl(routeName, new { action = "Edit", id = a.Id })
                                         ?? Url.Action("Edit", "Appointments", new { area = "Admin", id = a.Id });
                            var delHref = Url.RouteUrl(routeName, new { action = "Delete", id = a.Id })
                                          ?? Url.Action("Delete", "Appointments", new { area = "Admin", id = a.Id });
                            <tr>
                                <td>@(i++)</td>
                                @* === SỬA LỖI Ở ĐÂY: Thêm .ToLocalTime() === *@
                                <td>@(a != null ? a.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>@(a != null ? a.EndTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                @* === KẾT THÚC SỬA === *@
                                <td>@(a?.Patient?.FullName ?? "-")</td>
                                <td>@(a?.Doctor?.Name ?? "-")</td>
                                <td>@(a?.Service?.Name ?? "-")</td>
                                <td>@(a != null ? a.Status.ToString() : "-")</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-primary me-1" href="@editHref">Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" href="@delHref">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>