@* *** SỬA MODEL THÀNH VIEWMODEL *** *@
@model Clinic.Areas.Admin.Controllers.AdminDoctorEditViewModel
@{
    ViewBag.Title = "Sửa bác sĩ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    bool hasAccount = ViewBag.HasAccount ?? false; // Lấy trạng thái tài khoản
}

<h2 class="mb-3">Sửa bác sĩ: @Model.Name</h2>

@using (Html.BeginForm(
            "Edit",
            "Doctor",
            new { area = "Admin" },
            FormMethod.Post,
            new { enctype = "multipart/form-data" }
        ))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.UserId) @* Giữ UserId để biết có tài khoản hay không *@

    @* Partial form chứa các trường thông tin chung *@
    @Html.Partial("_DoctorForm", Model)

    @* *** THÊM PHẦN ĐẶT LẠI MẬT KHẨU (HIỂN THỊ CÓ ĐIỀU KIỆN) *** *@
    if (hasAccount)
    {
        <hr />
        <h4>Đặt lại mật khẩu (Để trống nếu không muốn thay đổi)</h4>

        @* Hiển thị lỗi validation chung liên quan đến mật khẩu *@
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                <small class="form-text text-muted">Ít nhất 6 ký tự.</small>
            </div>
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">Bác sĩ này chưa liên kết với tài khoản đăng nhập.</div>
    }
    @* *** KẾT THÚC THÊM *** *@

    <div class="mt-3">
        @* Thêm margin top *@
        <button class="btn btn-primary" type="submit">Cập nhật</button>
        @Html.ActionLink("Hủy", "Index", "Doctor", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @* Script preview ảnh đã được chuyển vào _DoctorForm.cshtml *@
}
