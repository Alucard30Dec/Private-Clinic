@model Clinic.Models.Doctor
@{
    ViewBag.Title = "Sửa bác sĩ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="mb-3">Sửa bác sĩ</h2>

@* BẮT BUỘC: khi có upload file, form phải có enctype="multipart/form-data" *@
@using (Html.BeginForm(
            "Edit",                 // action
            "Doctor",               // controller
            new { area = "Admin" }, // route values
            FormMethod.Post,
            new { enctype = "multipart/form-data" } // html attributes
        ))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    @* Partial form có input file name="photo" + các trường khác *@
    @Html.Partial("_DoctorForm", Model)

    <button class="btn btn-primary" type="submit">Cập nhật</button>
    @Html.ActionLink("Hủy", "Index", "Doctor", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
