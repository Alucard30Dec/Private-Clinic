@using System.Linq
@model IEnumerable<Clinic.Models.Doctor>
@{
    ViewBag.Title = "Danh sách bác sĩ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var q = Request["q"];
    Func<string, string> actionUrl = (action) =>
        Url.RouteUrl("Admin_Doctors_actions", new { action }) ??
        Url.Action(action, "Doctor", new { area = "Admin" });
    var createHref = actionUrl("Create");
    bool hasData = Model != null && Model.Any();
}
<div class="container-fluid py-3">
    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ok"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Danh sách bác sĩ</h2>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex" role="search">
                <input name="q" value="@q" class="form-control" placeholder="Tìm theo tên, chuyên khoa, email" />
                <button class="btn btn-primary ms-2" type="submit">Tìm</button>
            </form>
            <a class="btn btn-success" href="@createHref">Thêm mới</a>
        </div>
    </div>

    @if (!hasData)
    {
        <div class="text-muted fst-italic">Chưa có bác sĩ nào. Hãy bấm <a href="@createHref">Thêm mới</a>.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:72px">#</th>
                        <th>Ảnh</th>
                        <th>Họ tên</th>
                        <th>Chuyên khoa</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th class="text-end" style="width:1%; white-space:nowrap;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var d in Model)
                    {
                        var editHref = Url.RouteUrl("Admin_Doctors_actions", new { action = "Edit", id = d.Id })
                                         ?? Url.Action("Edit", "Doctor", new { area = "Admin", id = d.Id });
                        var deleteHref = Url.RouteUrl("Admin_Doctors_actions", new { action = "Delete", id = d.Id })
                                         ?? Url.Action("Delete", "Doctor", new { area = "Admin", id = d.Id });

                        <tr>
                            <td>@(i++)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.PhotoUrl))
                                {
                                    <img src="@d.PhotoUrl" alt="Ảnh" style="height:40px;width:40px;object-fit:cover;border-radius:6px;" />
                                }
                            </td>
                            <td>@(d?.Name ?? "-")</td>
                            <td>@(d?.Specialty ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(d?.Email) ? "-" : d.Email)</td>
                            <td>@(d?.PhoneNumber ?? "-")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-primary me-1" href="@editHref">Sửa</a>
                                <a class="btn btn-sm btn-outline-danger" href="@deleteHref">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
