@* *** THAY ĐỔI MODEL *** *@
@model Clinic.Areas.Admin.Controllers.AdminPatientEditViewModel
@{
    ViewBag.Title = "Sửa bệnh nhân";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var hasAccount = ViewBag.HasAccount as bool? ?? false; // Lấy trạng thái tài khoản từ ViewBag
}
<h2 class="mb-3">Sửa bệnh nhân</h2>

@using (Html.BeginForm("Edit", "Patients", new { area = "Admin" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.CreatedAt) @* Giữ lại giá trị CreatedAt *@

    @* Hiển thị lỗi validation chung *@
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    @* *** TRUYỀN Model (là ViewModel) VÀO PARTIAL *** *@
    @* Partial view sẽ render các trường thông tin cơ bản của Patient *@
    @Html.Partial("_PatientForm", Model) @* Truyền nguyên ViewModel *@

    @* *** THÊM PHẦN ĐẶT LẠI MẬT KHẨU (CHỈ HIỂN THỊ NẾU CÓ TÀI KHOẢN) *** *@
    if (hasAccount)
    {
        <fieldset class="mt-4 pt-3 border-top">
            @* Thêm fieldset để nhóm *@
            <legend class="h5">Đặt lại mật khẩu (Để trống nếu không đổi)</legend>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Nhập mật khẩu mới" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                    <small class="form-text text-muted">Ít nhất 6 ký tự.</small>
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>
            </div>
        </fieldset>
    }
    else
    {
        <div class="alert alert-info mt-3">Bệnh nhân này chưa liên kết với tài khoản đăng nhập.</div>
    }
    @* *** KẾT THÚC PHẦN MẬT KHẨU *** *@


    @* Nút bấm Submit và Hủy *@
    <div class="mt-3">
        @* Thêm khoảng cách *@
        <button class="btn btn-primary" type="submit">
            <i class="ti ti-device-floppy me-1"></i> Cập nhật
        </button>
        @Html.ActionLink("Hủy", "Index", "Patients", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
    </div>
}

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
}
