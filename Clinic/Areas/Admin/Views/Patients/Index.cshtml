@using System.Linq
@model IEnumerable<Clinic.Models.Patient>
@{
    ViewBag.Title = "Danh sách bệnh nhân";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var q = Request["q"];
    var createHref = Url.RouteUrl("Admin_Patients_actions", new { action = "Create" })
                   ?? Url.Action("Create", "Patients", new { area = "Admin" });
    bool hasData = Model != null && Model.Any();
}
<div class="container-fluid py-3">
    @if (TempData["ok"] != null)
    {<div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
    @if (TempData["err"] != null)
    {<div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["err"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
    @if (TempData["warn"] != null)
    {<div class="alert alert-warning alert-dismissible fade show" role="alert">@TempData["warn"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}

    <div class="d-flex justify-content-between mb-3 align-items-center">
        <h2 class="mb-0">Danh sách bệnh nhân</h2>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex">
                <input name="q" value="@q" class="form-control" placeholder="Tìm tên, email, SĐT, địa chỉ, giới tính..." />
                <button class="btn btn-primary ms-2" type="submit">Tìm</button>
                @if (!string.IsNullOrWhiteSpace(q))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-1" title="Xóa lọc">
                        <i class="ti ti-x"></i>
                    </a>
                }
            </form>
            <a class="btn btn-success text-nowrap" href="@createHref">Thêm mới</a>
        </div>
    </div>
    @if (!hasData)
    {
        <div class="text-muted fst-italic">Chưa có bệnh nhân. <a href="@createHref">Thêm mới</a>.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:64px">#</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Giới tính</th>
                        <th>Ngày sinh</th>
                        @* *** THÊM CỘT CCCD VÀ ĐỊA CHỈ *** *@
                        <th>Số CCCD</th>
                        <th>Địa chỉ</th>
                        @* *** KẾT THÚC THÊM *** *@
                        <th class="text-end" style="white-space:nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var p in Model)
                    {
                        var editHref = Url.RouteUrl("Admin_Patients_actions", new { action = "Edit", id = p.Id })
                                      ?? Url.Action("Edit", "Patients", new { area = "Admin", id = p.Id });
                        var delHref = Url.RouteUrl("Admin_Patients_actions", new { action = "Delete", id = p.Id })
                                      ?? Url.Action("Delete", "Patients", new { area = "Admin", id = p.Id });
                        <tr>
                            <td>@(i++)</td>
                            <td>@p.FullName</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Email)?"-":p.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.PhoneNumber)?"-":p.PhoneNumber)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Gender)?"-":p.Gender)</td>
                            <td>@(p.DateOfBirth.HasValue ? p.DateOfBirth.Value.ToString("dd/MM/yyyy") : "-")</td>
                            @* *** HIỂN THỊ DỮ LIỆU CCCD VÀ ĐỊA CHỈ *** *@
                            <td>@(string.IsNullOrWhiteSpace(p.NationalId) ? "-" : p.NationalId)</td>
                            <td class="text-truncate" style="max-width: 200px;" title="@p.Address">@(string.IsNullOrWhiteSpace(p.Address) ? "-" : p.Address)</td> @* Thêm truncate và title *@
                            @* *** KẾT THÚC HIỂN THỊ *** *@
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-primary me-1" href="@editHref">Sửa</a>
                                <a class="btn btn-sm btn-outline-danger" href="@delHref">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
