@model Clinic.Models.Appointment
@using Clinic.Models 
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; // Dùng layout Admin
    ViewBag.Title = "Đặt lịch cho Khách vãng lai";
    var request = ViewBag.RequestInfo as Clinic.Models.AppointmentRequest; // Lấy thông tin request
}

<h2>@ViewBag.Title</h2>

@* Hiển thị thông tin Request gốc *@
@if (request != null)
{
    <h4>Thông tin Yêu cầu gốc</h4>
    <div class="card mb-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tên:</dt>
                <dd class="col-sm-9">@request.Name</dd>
                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@request.Email</dd>
                <dt class="col-sm-3">Số điện thoại:</dt>
                <dd class="col-sm-9">@request.Phone</dd>
                <dt class="col-sm-3">Ngày mong muốn:</dt>
                <dd class="col-sm-9">@request.DesiredDate.ToString("dd/MM/yyyy")</dd>
                @if (!string.IsNullOrWhiteSpace(request.Message))
                {
                    <dt class="col-sm-3">Lời nhắn:</dt>
                    <dd class="col-sm-9">@request.Message</dd>
                }
            </dl>
        </div>
    </div>
    <hr />
}

@* Form Tạo Lịch hẹn *@
@using (Html.BeginForm("CreateAppointmentForRequest", "Reception", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("requestId", request?.Id ?? 0) @* Gửi lại requestId *@

    <h4>Nhập thông tin Lịch hẹn mới</h4>

    @* Các trường nhập liệu (ĐÃ BỎ ServiceId) *@

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.Label("DoctorId", "Bác sĩ", new { @class = "form-label" })
                @Html.DropDownList("DoctorId", (SelectList)ViewBag.DoctorId, "-- Chọn bác sĩ --", new { @class = "form-select", required = "required" })
                @Html.ValidationMessage("DoctorId", "", new { @class = "text-danger" })
            </div>
            @* ServiceId đã bị xóa *@
            <div class="mb-3">
                @Html.Label("Status", "Trạng thái", new { @class = "form-label" })
                @Html.DropDownList("Status", (SelectList)ViewBag.StatusList, new { @class = "form-select" })
                @Html.ValidationMessage("Status", "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.StartTime, new { @class = "form-label" })
                <input type="datetime-local" class="form-control" id="StartTime" name="StartTime" value="@(Model.StartTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" required />
                @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.EndTime, new { @class = "form-label" })
                <input type="datetime-local" class="form-control" id="EndTime" name="EndTime" value="@(Model.EndTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" required />
                @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Notes, 5, 90, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Xác nhận Đặt lịch</button>
        <a href="@Url.Action("Index", "Requests")" class="btn btn-secondary">Hủy</a>
    </div>
}

@* Thêm script validation nếu cần *@
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}