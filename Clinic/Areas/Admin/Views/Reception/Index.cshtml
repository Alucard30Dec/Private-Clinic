@model IEnumerable<Clinic.Models.Appointment>
@using Clinic.Models
@using System.Linq

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    string currentFilter = ViewBag.CurrentFilter ?? "today";
    string searchQuery = ViewBag.SearchQuery; // Get search query for repopulation
}

<h2>@ViewBag.Title</h2>

@* === UPDATED SEARCH FORM (Single Box) === *@
<form method="get" action="@Url.Action("Index", "Reception")" class="form-inline" style="margin-bottom: 15px;">
    @* Keep the current filter (today/all) active when searching *@
    <input type="hidden" name="filter" value="@currentFilter" />

    <div class="form-group">
        <label for="searchQuery" class="sr-only">Tìm kiếm</label>
        <input type="text" name="searchQuery" id="searchQuery" class="form-control"
               placeholder="Tìm theo tên BS, BN, Email, Dịch vụ..." value="@searchQuery" style="min-width: 300px;" />
    </div>

    <button type="submit" class="btn btn-info">Tìm kiếm</button>
    @* Clear button now clears searchQuery too *@
    <a href="@Url.Action("Index", "Reception", new { filter = currentFilter })" class="btn btn-default">Xóa lọc</a>
</form>
@* === END SEARCH FORM === *@


@* Keep the Today/All filter buttons *@
<div class="btn-group" role="group" style="margin-bottom: 15px;">
    <a href="@Url.Action("Index", "Reception", new { filter = "today", searchQuery = searchQuery })" @* Pass search query when changing filter *@
       class="btn @(currentFilter == "today" ? "btn-primary" : "btn-default")">
        Hôm nay
    </a>
    <a href="@Url.Action("Index", "Reception", new { filter = "all", searchQuery = searchQuery })" @* Pass search query when changing filter *@
       class="btn @(currentFilter == "all" ? "btn-primary" : "btn-default")">
        Tất cả
    </a>
</div>

@* Keep the Appointments Table as before *@
<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Ngày hẹn</th>
                <th>Giờ</th>
                <th>Bác sĩ</th>
                <th>Bệnh nhân</th>
                <th>Dịch vụ</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center">Không có lịch hẹn nào phù hợp.</td>
                </tr>
            }
            else
            {
                foreach (var a in Model)
                {
                    var localTime = a.StartTime.ToLocalTime();
                    <tr>
                        <td>@localTime.ToString("dd/MM/yyyy")</td>
                        <td>@localTime.ToString("HH:mm")</td>
                        <td>@(a.Doctor?.Name ?? "—")</td>
                        <td>@(a.Patient?.FullName ?? a.Patient?.Email ?? "—")</td>
                        <td>@(a.Service?.Name ?? "—")</td>
                        <td>
                            @{
                                string statusClass = "label-default";
                                if (a.Status == AppointmentStatus.Pending) { statusClass = "label-warning"; }
                                else if (a.Status == AppointmentStatus.Confirmed) { statusClass = "label-success"; }
                                else if (a.Status == AppointmentStatus.Canceled) { statusClass = "label-danger"; }
                                else if (a.Status == AppointmentStatus.Completed) { statusClass = "label-info"; }
                            }
                            <span class="label @statusClass">@a.Status</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@* Optional: Add pagination controls here *@

@section Scripts {
    <script>
        // Optional: Focus the search box on page load
        document.getElementById('searchQuery')?.focus();
    </script>
}