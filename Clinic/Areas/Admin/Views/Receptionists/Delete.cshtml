@model Clinic.Models.ApplicationUser @* Model là ApplicationUser *@
@{
    ViewBag.Title = "Xác nhận Xóa Lễ tân";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Nav = "receptionists";
}

<div class="container-fluid py-3">
    <h2 class="mb-3 text-danger">@ViewBag.Title</h2>
    <p>Bạn có chắc chắn muốn xóa tài khoản lễ tân sau? Hành động này sẽ xóa tài khoản đăng nhập của họ.</p>
    @* Cảnh báo nếu chỉ muốn gỡ Role *@
    @* <p class="text-warning">Nếu bạn chỉ muốn gỡ quyền Lễ tân mà không xóa tài khoản, hãy thực hiện trong phần quản lý Vai trò.</p> *@

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.Email</dd>
                <dt class="col-sm-3">UserId:</dt>
                <dd class="col-sm-9">@Model.Id</dd>
            </dl>
        </div>
    </div>


    @using (Html.BeginForm("Delete", "Receptionists", new { area = "Admin", id = Model.Id }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">
            <i class="ti ti-trash me-1"></i> Xác nhận Xóa
        </button>
        @Html.ActionLink("Hủy", "Index", "Receptionists", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
    }
</div>
