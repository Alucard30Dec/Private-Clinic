@model Clinic.Areas.Admin.Controllers.ReceptionistEditViewModel
@{
    ViewBag.Title = "Sửa thông tin Lễ tân";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Nav = "receptionists";
}

<div class="container-fluid py-3">
    <h2 class="mb-3">@ViewBag.Title: @Model.Email</h2>

    @using (Html.BeginForm("Edit", "Receptionists", new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.Email) @* Email không được sửa *@

        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
            </div>
        </div>

        <hr />
        <h4>Đặt lại mật khẩu (Để trống nếu không muốn thay đổi)</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                <small class="form-text text-muted">Ít nhất 6 ký tự.</small>
            </div>
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
            </div>
        </div>

        @* Optional: Lockout management
            <hr />
            <h4>Quản lý trạng thái</h4>
             <div class="mb-3 form-check">
                 @Html.CheckBoxFor(m => m.IsLockedOut, new { @class="form-check-input"})
                 @Html.LabelFor(m => m.IsLockedOut, new { @class="form-check-label"})
             </div>
        *@

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i> Cập nhật
            </button>
            @Html.ActionLink("Hủy", "Index", "Receptionists", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
