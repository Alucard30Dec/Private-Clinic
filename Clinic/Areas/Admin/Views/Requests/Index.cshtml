@model IEnumerable<Clinic.Models.AppointmentRequest>
@using System.Linq 
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Đơn đăng ký (khách vãng lai)";
    ViewBag.Nav = "requests";
}

<h2>Đơn đăng ký (khách vãng lai)</h2>

@if (TempData["ok"] != null)
{
    <div class="alert alert-success">@TempData["ok"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <thead>
            <tr>
                <th>Thời gian gửi</th>
                <th>Tên</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Ngày mong muốn</th>
                @* Cột Phòng ban đã xóa *@
                <th>Trạng thái</th>
                <th style="width:1%; white-space:nowrap;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @* === SỬA LỖI: Di chuyển comment vào trong { } === *@
            @if (!Model.Any())
            {
                @* Added check for empty model *@
                <tr>
                    <td colspan="7" class="text-center">Chưa có đơn đăng ký nào.</td>
                </tr>
            }
            else
            {
                foreach (var r in Model)
                {
                    <tr>
                        <td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                        <td>@r.Name</td>
                        <td>@r.Email</td>
                        <td>@r.Phone</td>
                        <td>@(r.DesiredDate.ToString("dd/MM/yyyy"))</td>
                        @* Cột Department data đã xóa *@
                        <td>@(r.IsHandled ? "Đã xử lý" : "Chưa xử lý")</td>
                        <td>
                            @if (!r.IsHandled)
                            {
                                <a href="@Url.Action("CreateAppointmentForRequest", "Reception", new { area = "Admin", requestId = r.Id })" class="btn btn-sm btn-primary">
                                    Đặt lịch
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>