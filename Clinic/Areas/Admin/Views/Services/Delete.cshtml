@model Clinic.Models.Service
@{
    ViewBag.Title = "Xác nhận ẩn Dịch vụ"; // Sửa title
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h2 class="mb-3 text-danger">@ViewBag.Title</h2>
<p>Bạn có chắc chắn muốn ẩn dịch vụ <strong>@Model.Name</strong> không?</p>
<p class="text-muted small">Dịch vụ này sẽ không hiển thị khi đặt lịch hẹn. Bạn có thể khôi phục lại sau (nếu cần).</p>


<dl class="row">
    <dt class="col-sm-3">Tên</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Loại hình</dt>
    <dd class="col-sm-9">@Model.ExamType.GetDisplayName()</dd> @* Hiển thị tên loại hình *@
    <dt class="col-sm-3">Giá</dt>
    <dd class="col-sm-9">@String.Format("{0:N0}", Model.Fee) VNĐ</dd>
    <dt class="col-sm-3">Thời lượng</dt>
    <dd class="col-sm-9">@(Model.DurationMinutes.HasValue ? Model.DurationMinutes + " phút" : "-")</dd>
</dl>
@using (Html.BeginForm("Delete", "Services", new { area = "Admin", id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="mt-3">
        <button class="btn btn-danger" type="submit">
            <i class="ti ti-trash me-1"></i> Xác nhận Ẩn
        </button>
        @Html.ActionLink("Hủy", "Index", "Services", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
    </div>
}
