@model Clinic.Models.Service
@{ ViewBag.Title = "Sửa dịch vụ"; Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; }
<h2 class="mb-3">Sửa dịch vụ</h2>
@using (Html.BeginForm("Edit", "Services", new { area = "Admin" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.Partial("_ServiceForm", Model)
    <button class="btn btn-primary" type="submit">Cập nhật</button>
    @Html.ActionLink("Hủy", "Index", "Services", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
}
@section Scripts{ @Scripts.Render("~/bundles/jqueryval") }
