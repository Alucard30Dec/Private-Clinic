@using System.Collections.Generic
@model IEnumerable<Clinic.Models.Service>

@{
    ViewBag.Title = "Danh sách dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    // Route alias nếu đã đăng ký; nếu không có sẽ fallback về Url.Action
    var routeNameActions = "Admin_Services_actions";
    var createHref = Url.RouteUrl(routeNameActions, new { action = "Create" })
                   ?? Url.Action("Create", "Services", new { area = "Admin" });

    var q = Request["q"];

    // --- KIỂM TRA RỖNG AN TOÀN (không phụ thuộc Linq.Any()) ---
    bool hasData = false;
    if (Model != null)
    {
        var col = Model as ICollection<Clinic.Models.Service>;
        if (col != null)
        {
            hasData = col.Count > 0;
        }
        else
        {
            // Duyệt 1 phần tử là biết có dữ liệu
            foreach (var _ in Model)
            {
                hasData = true;
                break;
            }
        }
    }
}

<div class="container-fluid py-3">
    @* Thông báo *@
    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["warn"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["warn"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Danh sách dịch vụ</h2>

        <div class="d-flex gap-2">
            <form method="get" class="d-flex" role="search">
                <input name="q" value="@q" class="form-control" placeholder="Tìm theo tên" />
                <button class="btn btn-primary ms-2" type="submit">Tìm</button>
            </form>

            <a class="btn btn-success" href="@createHref">Thêm mới</a>
        </div>
    </div>

    @{ // Bọc toàn bộ nhánh if/else để Razor không nhầm
        if (!hasData)
        {
            <div class="text-muted fst-italic">
                Chưa có dịch vụ. Hãy bấm <a href="@createHref">Thêm mới</a> để tạo.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:72px">#</th>
                            <th>Tên dịch vụ</th>
                            <th>Giá</th>
                            <th>Thời lượng (phút)</th>
                            <th class="text-end" style="width:1%; white-space:nowrap;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var i = 1;
                        }
                        @foreach (var s in Model)
                        {
                            var editHref = Url.RouteUrl(routeNameActions, new { action = "Edit", id = s.Id })
                                           ?? Url.Action("Edit", "Services", new { area = "Admin", id = s.Id });

                            var delHref = Url.RouteUrl(routeNameActions, new { action = "Delete", id = s.Id })
                                          ?? Url.Action("Delete", "Services", new { area = "Admin", id = s.Id });

                            <tr>
                                <td>@(i++)</td>
                                <td>@(s?.Name ?? "-")</td>
                                <td>@(s != null ? s.Fee.ToString("N0") : "-")</td>
                                <td>@(s?.DurationMinutes.HasValue == true ? s.DurationMinutes.Value.ToString() : "-")</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-primary me-1" href="@editHref">Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" href="@delHref">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
