@using Clinic.Models // Thêm để dùng ExamType
@model IEnumerable<Clinic.Models.Service>
@{
    ViewBag.Title = "Danh sách dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var routeNameActions = "Admin_Services_actions";
    var createHref = Url.RouteUrl(routeNameActions, new { action = "Create" }) ?? Url.Action("Create", "Services", new { area = "Admin" });
    var q = Request["q"];
    bool hasData = Model != null && Model.Any();
}

<div class="container-fluid py-3">
    @* TempData messages (giữ nguyên) *@
    @if (TempData["ok"] != null)
    {<div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
    @if (TempData["warn"] != null)
    {<div class="alert alert-warning alert-dismissible fade show" role="alert">@TempData["warn"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
    @if (TempData["err"] != null)
    {<div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["err"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Danh sách dịch vụ</h2>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex" role="search">
                <input name="q" value="@q" class="form-control" placeholder="Tìm theo tên" />
                <button class="btn btn-primary ms-2" type="submit">Tìm</button>
                @if (!string.IsNullOrWhiteSpace(q))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-1" title="Xóa lọc"><i class="ti ti-x"></i></a>
                }
            </form>
            <a class="btn btn-success text-nowrap" href="@createHref"><i class="ti ti-plus me-1"></i>Thêm mới</a>
        </div>
    </div>

    @if (!hasData)
    {
        <div class="alert alert-info">Chưa có dịch vụ. Hãy bấm <a href="@createHref">Thêm mới</a>.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:72px">#</th>
                        <th>Tên dịch vụ</th>
                        <th>Loại hình</th> @* Thêm cột Loại hình *@
                        <th>Giá (VNĐ)</th>
                        <th>Thời lượng (phút)</th>
                        <th class="text-end" style="width:1%; white-space:nowrap;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var s in Model)
                    {
                        var editHref = Url.RouteUrl(routeNameActions, new { action = "Edit", id = s.Id }) ?? Url.Action("Edit", "Services", new { area = "Admin", id = s.Id });
                        var delHref = Url.RouteUrl(routeNameActions, new { action = "Delete", id = s.Id }) ?? Url.Action("Delete", "Services", new { area = "Admin", id = s.Id });

                        <tr>
                            <td>@(i++)</td>
                            <td>@(s?.Name ?? "-")</td>
                            @* *** HIỂN THỊ TÊN LOẠI HÌNH *** *@
                            <td>@s.ExamType.GetDisplayName()</td> @* Giả sử có helper GetDisplayName() *@
                            @* Hoặc @s.ExamType.ToString() nếu không có helper *@
                            @* *** KẾT THÚC HIỂN THỊ *** *@
                            <td>@(s != null ? s.Fee.ToString("N0") : "-")</td>
                            <td>@(s?.DurationMinutes.HasValue == true ? s.DurationMinutes.Value.ToString() : "-")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-primary me-1" href="@editHref">
                                    <i class="ti ti-pencil me-1"></i> Sửa
                                </a>
                                <a class="btn btn-sm btn-outline-danger" href="@delHref">
                                    <i class="ti ti-trash me-1"></i> Ẩn
                                </a> @* Sửa thành nút Ẩn *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
