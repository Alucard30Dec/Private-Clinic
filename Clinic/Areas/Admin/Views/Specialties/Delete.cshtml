@model Clinic.Models.Specialty
@{
    ViewBag.Title = "Xác nhận ẩn Chuyên khoa"; // Sửa title
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h2 class="mb-3 text-danger">@ViewBag.Title</h2>
<p>Bạn có chắc chắn muốn ẩn chuyên khoa <strong>@Model.Name</strong> không?</p>
<p class="text-muted small">Chuyên khoa này sẽ không hiển thị khi thêm/sửa bác sĩ và không thể chọn khi đặt lịch. Bạn có thể khôi phục lại sau (nếu cần chức năng đó).</p>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Tên chuyên khoa</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

@using (Html.BeginForm("Delete", "Specialties", new { area = "Admin", id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <button class="btn btn-danger" type="submit">
            <i class="ti ti-trash me-1"></i> Xác nhận Ẩn
        </button>
        @Html.ActionLink("Hủy", "Index", "Specialties", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
    </div>
}
