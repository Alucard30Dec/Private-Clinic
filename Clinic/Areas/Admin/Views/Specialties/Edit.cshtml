@model Clinic.Models.Specialty
@{
    ViewBag.Title = "Sửa chuyên khoa";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h2 class="mb-3">@ViewBag.Title: @Model.Name</h2>
@using (Html.BeginForm("Edit", "Specialties", new { area = "Admin" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.Partial("_SpecialtyForm", Model)
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">
            <i class="ti ti-device-floppy me-1"></i> Cập nhật
        </button>
        @Html.ActionLink("Hủy", "Index", "Specialties", new { area = "Admin" }, new { @class = "btn btn-secondary ms-2" })
    </div>
}
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
