@model Clinic.Models.Specialty

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

<div class="mb-3">
    @Html.LabelFor(m => m.Name, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required", placeholder = "Nhập tên chuyên khoa", autofocus = "autofocus" })
    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
</div>
