@model Clinic.Models.WorkingHour
@{
    ViewBag.Title = "Sửa ca làm việc";
}

<div class="container-fluid py-3">
    <h2 class="mb-3">@ViewBag.Title</h2>

    @using (Html.BeginForm("Edit", "WorkShifts", new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id) @* Don't forget the ID for edit *@

        @Html.Partial("_WorkShiftForm", Model)

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i> Cập nhật
            </button>
            <a href="@Url.Action("Index", new { doctorIdFilter = Model?.DoctorId })" class="btn btn-secondary ms-2">
                <i class="ti ti-arrow-back-up me-1"></i> Hủy
            </a>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
