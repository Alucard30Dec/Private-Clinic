@model IEnumerable<Clinic.Models.WorkingHour>
@using Clinic.Models // For DayOfWeek enum
@using System.Globalization // For CultureInfo
@{
    ViewBag.Title = "Quản lý Ca làm việc";
    // Layout defined in _ViewStart.cshtml

    // *** SỬA Ở ĐÂY: Lấy đúng tên ViewBag từ Controller ***
    var doctorListForDropdown = ViewBag.DoctorList as SelectList;
    // *** KẾT THÚC SỬA ***

    int? selectedDoctorId = ViewBag.SelectedDoctorId;
    var currentCulture = CultureInfo.CurrentCulture; // Để lấy tên Thứ
}

<div class="container-fluid py-3">

    @* TempData Messages *@
    @if (TempData["ok"] != null)
    {<div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
    @if (TempData["err"] != null)
    {<div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["err"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewBag.Title</h2>
        <div class="d-flex gap-2">
            @* Filter Form *@
            <form method="get" class="d-flex align-items-center">
                @* Dùng biến doctorListForDropdown đã sửa *@
                @Html.DropDownList("doctorIdFilter", doctorListForDropdown, "-- Lọc theo bác sĩ --", new { @class = "form-select form-select-sm" })
                <button type="submit" class="btn btn-sm btn-primary ms-2">Lọc</button>
                @if (selectedDoctorId.HasValue)
                {
                    @* Nút xóa lọc, trỏ về Action Index không có tham số *@
                    <a href="@Url.Action("Index", "WorkShifts", new { area = "Admin" })" class="btn btn-sm btn-outline-secondary ms-1" title="Xóa lọc">
                        <i class="ti ti-x"></i>
                    </a>
                }
            </form>
            @* Create Button (Link đến Action Create, có thể truyền doctorId nếu đang lọc) *@
            <a href="@Url.Action("Create", "WorkShifts", new { area = "Admin", doctorId = selectedDoctorId })" class="btn btn-sm btn-success">
                <i class="ti ti-plus me-1"></i> Thêm ca làm
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @if (selectedDoctorId.HasValue)
            {
                <span>Bác sĩ này chưa có ca làm nào được đăng ký.</span>
            }
            else
            {
                <span>Chưa có ca làm nào được đăng ký.</span>
            }
            @* Thêm gợi ý tạo mới *@
            <a href="@Url.Action("Create", "WorkShifts", new { area = "Admin", doctorId = selectedDoctorId })" class="alert-link ms-2">Thêm ca làm?</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        @if (!selectedDoctorId.HasValue) // Chỉ hiển thị cột Bác sĩ nếu không lọc
                        {
                            <th>Bác sĩ</th>
                        }
                        <th>Thứ</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th class="text-end" style="width:1%; white-space:nowrap;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model)
                    {
                        <tr>
                            @if (!selectedDoctorId.HasValue)
                            {
                                <td>@(shift.Doctor?.Name ?? "N/A")</td>
                            }
                            <td>@currentCulture.DateTimeFormat.GetDayName(shift.DayOfWeek)</td> @* Hiển thị tên Thứ *@
                            <td>@shift.Start.ToString(@"hh\:mm")</td>
                            <td>@shift.End.ToString(@"hh\:mm")</td>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("Edit", "WorkShifts", new { area = "Admin", id = shift.Id })" class="btn btn-sm btn-primary me-1">
                                    <i class="ti ti-pencil me-1"></i> Sửa
                                </a>
                                <a href="@Url.Action("Delete", "WorkShifts", new { area = "Admin", id = shift.Id })" class="btn btn-sm btn-outline-danger">
                                    <i class="ti ti-trash me-1"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
