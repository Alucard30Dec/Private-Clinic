@model IEnumerable<Clinic.Areas.Doctor.Data.MyPatientRowVM>
@{
    ViewBag.Title = "Bệnh nhân của tôi";
    ViewBag.Nav = "mypatients";
    var q = ViewBag.q as string;
}
<div class="card shadow-sm border-0">
    @* Thêm shadow và border-0 *@
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@ViewBag.Title</h5>
        <form method="get" class="d-flex" role="search">
            <input name="q" value="@q" class="form-control form-control-sm" placeholder="Tìm tên / SĐT / Email / Giới tính" /> @* Sửa placeholder, thêm form-control-sm *@
            <button class="btn btn-sm btn-primary ms-2" type="submit">
                <i class="ti ti-search me-1"></i> Tìm @* Thêm icon *@
            </button>
            @if (!string.IsNullOrWhiteSpace(q))
            {
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary ms-1" title="Xóa lọc">
                    <i class="ti ti-x"></i>
                </a>
            }
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card-body">
            <p class="text-muted fst-italic">Không có bệnh nhân nào khớp với tìm kiếm hoặc bạn chưa có bệnh nhân nào.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                @* Thêm table-striped *@
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th> @* Cho cột STT nhỏ lại *@
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        @* <th>Email</th> *@ @* Ẩn Email cho gọn *@
                        <th>Giới tính</th> @* Thêm cột Giới tính *@
                        <th>Tuổi</th> @* Thêm cột Tuổi *@
                        <th class="text-center">Số lần khám</th> @* Căn giữa *@
                        <th>Lần gần nhất</th>
                        <th class="text-end">Thao tác</th> @* Căn phải *@
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@p.FullName</td>
                            <td>@(p.PhoneNumber ?? "-")</td> @* Thêm ?? "-" *@
                            @* <td>@(p.Email ?? "-")</td> *@
                            <td>@(p.Gender ?? "-")</td> @* Hiển thị giới tính *@
                            <td>@(p.Age.HasValue ? p.Age.Value.ToString() : "-")</td> @* Hiển thị tuổi *@
                            <td class="text-center">@p.TotalVisits</td> @* Căn giữa *@
                            <td>@(p.LastVisit?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td> @* Chuyển sang LocalTime *@
                            <td class="text-end text-nowrap">
                                @* Căn phải, không xuống dòng *@
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Details", new { id = p.PatientId })">
                                    <i class="ti ti-eye me-1"></i> Xem hồ sơ @* Thêm icon *@
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    } @* Đóng else *@
</div>
