@model IEnumerable<Clinic.Areas.Doctor.Data.MyPatientRowVM>
@{
    ViewBag.Title = "Bệnh nhân của tôi";
    ViewBag.Nav = "mypatients";
    var q = ViewBag.q as string;
}
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Bệnh nhân của tôi</h5>
        <form method="get" class="d-flex" role="search">
            <input name="q" value="@q" class="form-control" placeholder="Tìm tên / SĐT / Email" />
            <button class="btn btn-primary ms-2" type="submit">Tìm</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Họ tên</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Ngày sinh</th>
                    <th>Số lần khám</th>
                    <th>Lần gần nhất</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                    foreach (var p in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@p.FullName</td>
                            <td>@p.PhoneNumber</td>
                            <td>@p.Email</td>
                            <td>@(p.DOB?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@p.TotalVisits</td>
                            <td>@(p.LastVisit?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Details", new { id = p.PatientId })">Xem hồ sơ</a>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
