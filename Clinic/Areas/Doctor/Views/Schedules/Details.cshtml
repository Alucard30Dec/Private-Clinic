@model Clinic.Areas.Doctor.Data.AppointmentDetailVM
@{
    ViewBag.Title = "Chi tiết lịch khám";
    ViewBag.Nav = "schedules";
}
<div class="card">
    <div class="card-header bg-white"><h5 class="mb-0">Chi tiết lịch hẹn #@Model.Id</h5></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Bệnh nhân</dt>
            <dd class="col-sm-9">@Model.PatientFullName</dd>
            <dt class="col-sm-3">Điện thoại</dt>
            <dd class="col-sm-9">@Model.PatientPhone</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.PatientEmail</dd>
            <dt class="col-sm-3">Dịch vụ</dt>
            <dd class="col-sm-9">@Model.ServiceFullName</dd>
            <dt class="col-sm-3">Thời gian</dt>
            <dd class="col-sm-9">@Model.StartTime:dd/MM/yyyy HH:mm — @Model.EndTime:dd/MM/yyyy HH:mm</dd>
            <dt class="col-sm-3">Ghi chú</dt>
            <dd class="col-sm-9">@Model.Notes</dd>
            <dt class="col-sm-3">Tạo lúc</dt>
            <dd class="col-sm-9">@Model.CreatedAt</dd>
            <dt class="col-sm-3">Cập nhật</dt>
            <dd class="col-sm-9">@Model.UpdatedAt</dd>
        </dl>
        <a class="btn btn-secondary" href="@Url.Action("Index")">Quay lại</a>
    </div>
</div>
