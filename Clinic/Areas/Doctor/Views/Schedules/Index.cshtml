@model IEnumerable<Clinic.Areas.Doctor.Data.AppointmentRowVM>
@{
    ViewBag.Title = "Lịch khám của tôi";
    ViewBag.Nav = "schedules";
    Func<int, int, string> badge = (s, _) =>
        s == 1 ? "<span class='badge bg-success'>Đã xác nhận</span>" :
        s == 2 ? "<span class='badge bg-secondary'>Đã hoàn thành</span>" :
               "<span class='badge bg-warning text-dark'>Đang chờ</span>";
}
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách lịch khám</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Bệnh nhân</th>
                    <th>Dịch vụ</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                    foreach (var a in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@a.PatientFullName</td>
                            <td>@a.ServiceFullName</td>
                            <td>@a.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@a.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@Html.Raw(badge(a.Status, 0))</td>
                            <td class="text-truncate" style="max-width:240px">@a.Notes</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Details", new { id = a.Id })">Chi tiết</a>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
