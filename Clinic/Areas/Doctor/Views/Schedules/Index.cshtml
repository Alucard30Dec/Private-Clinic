@model IEnumerable<Clinic.Areas.Doctors.Data.AppointmentRowVM>
@{
    ViewBag.Title = "Lịch khám của tôi";
    ViewBag.Nav = "schedules";
    Func<int, string> badge = s =>
    {
        switch (s)
        {
            case 0: return "<span class=\"badge bg-secondary\">Chờ xác nhận</span>";
            case 1: return "<span class=\"badge bg-info\">Đã xác nhận</span>";
            case 2: return "<span class=\"badge bg-success\">Đã khám</span>";
            case 3: return "<span class=\"badge bg-danger\">Huỷ</span>";
            default: return "<span class=\"badge bg-light text-dark\">N/A</span>";
        }
    };
}
<h4 class="mb-3">Lịch khám của tôi</h4>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px">#</th>
                    <th>Bệnh nhân</th>
                    <th>Dịch vụ</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú</th>
                    <th style="width:110px">Xem</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                    foreach (var a in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@a.PatientName</td>
                            <td>@a.ServiceName</td>
                            <td>@a.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@a.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@Html.Raw(badge(a.Status))</td>
                            <td class="text-truncate" style="max-width:240px">@a.Notes</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Details", new { id = a.Id })">Chi tiết</a>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
