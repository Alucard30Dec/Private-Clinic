@using Microsoft.AspNet.Identity
@using Clinic.Models // Thêm để dùng ClinicDbContext và Doctor
@{
    // Khởi tạo DbContext chỉ khi cần
    ClinicDbContext db = null;
    Clinic.Models.Doctor currentDoctor = null;
    string doctorName = User.Identity.Name; // Mặc định là email/username
    string doctorAvatarUrl = "~/Resources/images/avatar-doctor.png"; // Ảnh mặc định

    // Chỉ truy vấn DB nếu đã đăng nhập
    if (User.Identity.IsAuthenticated)
    {
        try
        {
            db = new ClinicDbContext();
            var userId = User.Identity.GetUserId();
            currentDoctor = db.Doctors.FirstOrDefault(d => d.UserId == userId); // Tìm bác sĩ theo UserId
            if (currentDoctor != null)
            {
                doctorName = currentDoctor.Name; // Lấy tên thật từ hồ sơ Doctor
                if (!string.IsNullOrWhiteSpace(currentDoctor.PhotoUrl))
                {
                    doctorAvatarUrl = currentDoctor.PhotoUrl; // Lấy ảnh từ hồ sơ Doctor nếu có
                }
            }
        }
        finally
        {
            // Đảm bảo DbContext được giải phóng
            db?.Dispose();
        }
    }
}
<header class="admin-header px-3">
    @* Tái sử dụng class admin-header cho đồng bộ *@
    <div class="d-flex align-items-center justify-content-between">
        @* Nút toggle sidebar cho mobile (nếu layout Doctor có sidebar) *@
        <button class="btn btn-sm btn-outline-light d-lg-none" id="sidebarToggleDoctor">
            @* Đổi ID nếu cần *@
            <i class="ti ti-menu-2"></i>
        </button>

        @* Tên Panel (chỉ hiển thị trên desktop) *@
        <div class="d-none d-lg-flex align-items-center gap-3">
            <span class="text-white-50 small">Bác sĩ Panel</span>
        </div>

        @* Thông tin bác sĩ và nút đăng xuất *@
        <div class="d-flex align-items-center gap-2">
            @* Giảm khoảng cách còn gap-2 *@
            @* Tên Bác sĩ *@
            <span class="text-white small">@doctorName</span>

            @* Avatar Bác sĩ *@
            <img src="@Url.Content(doctorAvatarUrl)" alt="Avatar" width="32" height="32" class="rounded-circle border border-light border-opacity-25" />

            @* *** ĐÃ XÓA NÚT THÔNG BÁO *** *@

            @* Nút đăng xuất (icon) *@
            @using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutFormDoctorHeader", style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-icon btn-outline-warning rounded-circle" title="Đăng xuất" style="width: 32px; height: 32px; line-height: 1;">
                    <i class="ti ti-logout fs-6"></i>
                </button>
            }
        </div>
    </div>
</header>

