@{
    Layout = null;
    var title = string.IsNullOrEmpty(ViewBag.Title as string)
        ? "Clinic Doctor"
        : (ViewBag.Title + " · Clinic Doctor");
    var nav = (ViewBag.Nav as string ?? "").ToLower();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @Styles.Render("~/Content/css")
    @RenderSection("styles", false)

    @* Copy CSS from Admin CSS for consistency *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/%40tabler/icons-webfont@2.47.0/tabler-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/admin.css")" />


    <style>
        /* Căn style cho các item trong sidebar */
        .sidebar a.nav-link {
            display: block;
            padding: 10px 14px;
            border-radius: 8px;
        }
        /* Nút logout hiển thị giống a.nav-link */
        .sidebar .logout-link {
            display: block;
            width: 100%;
            padding: 10px 14px;
            border-radius: 8px;
            color: #dc3545; /* Red color for logout */
            background: transparent;
            border: 0;
            text-align: left;
            cursor: pointer;
        }

            .sidebar .logout-link:hover {
                background: rgba(220, 53, 69, 0.1); /* Light red background on hover */
                text-decoration: none;
            }
        /* Style adjustments to match Admin layout more closely */
        body {
            background-color: #f8f9fa;
        }
        /* Light grey background like admin */
        .sidebar {
            width: 260px;
            background: #2c3e50;
            min-height: 100vh;
        }
            /* Dark blue sidebar like admin */
            .sidebar .brand {
                color: #fff;
                font-size: 1.1rem;
            }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.7);
            }

                .sidebar .nav-link.active, .sidebar .nav-link:hover {
                    color: #fff;
                    background-color: rgba(255,255,255,0.1);
                }

                .sidebar .nav-link i {
                    margin-right: 8px;
                }
            /* Consistent icon margin */
            .sidebar .text-muted {
                color: rgba(255,255,255,0.4) !important;
            }
        /* Lighter muted text */

    </style>
</head>
<body>
    @* Removed bg-light, handled by CSS *@
    <div class="d-flex admin-wrapper">
        @* Use admin-wrapper class for consistency *@
        <!-- Sidebar -->
        <nav class="flex-shrink-0 sidebar admin-sidebar">
            @* Use admin-sidebar class *@
            <div class="p-3 brand d-flex align-items-center">
                @* Use brand class *@
                <i class="ti ti-stethoscope icon-brand me-2"></i> @* Icon Doctor *@
                Bác sĩ Panel
            </div>
            <ul class="nav flex-column mb-auto px-2 mt-2">
                @* Add mt-2 like admin *@
                <li class="nav-item">
                    <a class="nav-link @(nav=="dashboard"?"active":"")"
                       href="@Url.Action("Index","Home", new { area="Doctor" })">
                        <i class="ti ti-layout-dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item mt-2 text-uppercase small px-3 text-muted">Nghiệp vụ</li>
                <li>
                    <a class="nav-link @(nav=="schedules"?"active":"")"
                       href="@Url.Action("Index","Schedules", new { area="Doctor" })">
                        <i class="ti ti-calendar-share"></i> Lịch khám của tôi
                    </a>
                </li>
                <li>
                    <a class="nav-link @(nav=="mypatients"?"active":"")"
                       href="@Url.Action("Index","Patients", new { area="Doctor" })">
                        <i class="ti ti-address-book"></i> Bệnh nhân của tôi
                    </a>
                </li>
                <li>
                    <a class="nav-link @(nav=="records"?"active":"")"
                       href="@Url.Action("Index","Records", new { area="Doctor" })">
                        <i class="ti ti-notes"></i> Hồ sơ khám
                    </a>
                </li>
                @* === THÊM LINK ĐĂNG KÝ CA LÀM === *@
                <li>
                    <a class="nav-link @(nav=="workshifts"?"active":"")"
                       href="@Url.Action("Index","WorkShifts", new { area="Doctor" })">
                        <i class="ti ti-clock-plus"></i> Đăng ký ca làm
                    </a>
                </li>
                @* === KẾT THÚC THÊM LINK === *@


                <li class="nav-item mt-2 text-uppercase small px-3 text-muted">Hệ thống</li>
                <li>
                    <a class="nav-link"
                       href="@Url.Action("Index","Home", new { area="" })">
                        <i class="ti ti-home-2"></i> Về trang người dùng
                    </a>
                </li>

                <!-- Đăng xuất (POST + AntiForgery) đã căn thẳng hàng -->
                <li>
                    @using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutFormDoctor", @class = "d-inline" })) // Unique ID
                    {
                        @Html.AntiForgeryToken()
                        <a href="javascript:document.getElementById('logoutFormDoctor').submit()" class="nav-link text-danger">
                            @* Apply nav-link and text-danger *@
                            <i class="ti ti-logout me-2"></i> Đăng xuất
                        </a>
                    }
                </li>
            </ul>
            @* Removed footer text from here, will use partial like admin *@
        </nav>

        <!-- Main -->
        <main class="flex-grow-1 admin-main d-flex flex-column">
            @* Use admin-main class *@
            @Html.Partial("~/Areas/Admin/Views/Shared/_HeaderAdmin.cshtml") @* Reuse Admin Header *@
            <div class="container-fluid py-4 admin-content">
                @* Use admin-content class *@
                @* Include TempData rendering like admin *@
                @if (TempData["ok"] != null)
                {<div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
                @if (TempData["error"] != null || TempData["err"] != null)
                {<div class="alert alert-danger alert-dismissible fade show" role="alert">@(TempData["error"] ?? TempData["err"])<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
                @if (TempData["warn"] != null)
                {<div class="alert alert-warning alert-dismissible fade show" role="alert">@TempData["warn"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
                @if (TempData["info"] != null)
                {<div class="alert alert-info alert-dismissible fade show" role="alert">@TempData["info"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}

                @RenderBody()
            </div>
            @Html.Partial("~/Areas/Admin/Views/Shared/_FooterAdmin.cshtml") @* Reuse Admin Footer *@
        </main>
    </div>

    @* Use scripts from admin layout *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/admin.js")"></script>
    @RenderSection("scripts", false)
</body>
</html>
