@model IEnumerable<Clinic.Models.AppointmentRequest>
@using System.Linq
@{
    // Layout được chỉ định bởi _ViewStart.cshtml trong cùng thư mục hoặc thư mục cha
    ViewBag.Title = "Đơn đăng ký (khách vãng lai)";
    ViewBag.Nav = "requests"; // Key cho layout Reception
}

<h2>@ViewBag.Title</h2>

@if (TempData["ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ok"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["err"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["err"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover align-middle">
        <thead>
            <tr>
                <th>Thời gian gửi</th>
                <th>Tên</th>
                @* === SỬA ĐỔI: Tách thành 2 cột === *@
                <th>Email</th>
                <th>Phone</th>
                @* === KẾT THÚC SỬA ĐỔI === *@
                <th>Chuyên khoa YC</th>
                <th>Giờ hẹn YC</th>
                <th>Trạng thái</th>
                <th style="width:1%; white-space:nowrap;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    @* === SỬA ĐỔI: Cập nhật colspan === *@
                    <td colspan="8" class="text-center fst-italic text-muted">Chưa có đơn đăng ký nào.</td>
                    @* === KẾT THÚC SỬA ĐỔI === *@
                </tr>
            }
            else
            {
                foreach (var r in Model)
                {
                    <tr>
                        <td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@r.Name</td>
                        @* === SỬA ĐỔI: Hiển thị trong 2 cột riêng biệt === *@
                        <td>@(string.IsNullOrWhiteSpace(r.Email) ? "—" : r.Email)</td>
                        <td>@(string.IsNullOrWhiteSpace(r.Phone) ? "—" : r.Phone)</td>
                        @* === KẾT THÚC SỬA ĐỔI === *@
                        <td>@r.Specialty</td>
                        <td>@r.RequestedSlot.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (r.IsHandled)
                            {<span class="badge bg-secondary">Đã xử lý</span> }
                            else
                            { <span class="badge bg-warning text-dark">Chưa xử lý</span>}
                        </td>
                        <td class="text-nowrap">
                            @if (!r.IsHandled)
                            {
                                // *** Url.Action trỏ về ReceptionController trong Area Reception ***
                                <a href="@Url.Action("CreateAppointmentForRequest", "Reception", new { area = "Reception", requestId = r.Id })" class="btn btn-sm btn-primary">
                                    <i class="ti ti-calendar-plus me-1"></i> Đặt lịch
                                </a>

                                // Form để xóa
                                using (Html.BeginForm("Delete", "Requests", new { area = "Reception", id = r.Id }, FormMethod.Post, new { @style = "display:inline;", onsubmit = "return confirm('Xóa yêu cầu này?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                        <i class="ti ti-trash me-1"></i> Xóa YC
                                    </button>
                                }
                            }
                            else
                            {
                                // Form để đánh dấu lại là chưa xử lý (nếu muốn) hoặc chỉ hiển thị text
                                using (Html.BeginForm("MarkHandled", "Requests", new { area = "Reception", id = r.Id }, FormMethod.Post, new { @style = "display:inline;", onsubmit = "return confirm('Đánh dấu là CHƯA xử lý?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @* Có thể ẩn nút này hoặc thay bằng text nếu không muốn cho phép un-handle *@
                                    @*<button type="submit" class="btn btn-sm btn-outline-secondary ms-1" title="Đánh dấu lại là Chưa xử lý">
                                            <i class="ti ti-arrow-back-up"></i> Hủy xử lý
                                        </button>*@
                                    <span class="text-muted fst-italic">—</span>
                                }

                                // Form để xóa (vẫn cho phép xóa cả đơn đã xử lý)
                                using (Html.BeginForm("Delete", "Requests", new { area = "Reception", id = r.Id }, FormMethod.Post, new { @style = "display:inline;", onsubmit = "return confirm('Xóa yêu cầu này?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                        <i class="ti ti-trash me-1"></i> Xóa YC
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

