@using System.Web.Mvc.Html
@{
    Layout = null; // Layout này là layout gốc
    var title = ViewBag.Title as string ?? "Reception Panel";
    var currentNav = (ViewBag.Nav as string ?? "").ToLower();

    // URLs for Reception Area
    var dashboardUrl = Url.Action("Index", "Dashboard", new { area = "Reception" });
    var requestsUrl = Url.Action("Index", "Requests", new { area = "Reception" });
    var appointmentsListUrl = Url.Action("AppointmentsList", "Reception", new { area = "Reception" });
    // *** THÊM URL XEM CA LÀM CHO LỄ TÂN ***
    var viewWorkShiftsUrl = Url.Action("Index", "WorkShifts", new { area = "Reception" });
    // Giả sử có action tạo lịch hẹn trực tiếp (chưa code controller)
    var createAppUrl = Url.Action("Create", "Reception", new { area = "Reception" });
    // Giả sử có action tìm bệnh nhân (chưa code controller)
    var searchPatientUrl = Url.Action("SearchPatient", "Reception", new { area = "Reception" });
    var siteHomeUrl = Url.Action("Index", "Home", new { area = "" }); // Về trang chủ public
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    @* Copy các link CSS từ _LayoutAdmin *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/%40tabler/icons-webfont@2.47.0/tabler-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/admin.css")" /> @* Tái sử dụng admin.css *@

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper d-flex">
        @* Tái sử dụng class từ admin layout *@
        <aside class="admin-sidebar">
            <div class="brand px-3 py-3 d-flex align-items-center">
                <i class="ti ti-headset icon-brand me-2"></i> @* Icon khác cho Lễ tân *@
                <span class="fw-semibold">Reception Panel</span>
            </div>

            <nav class="mt-2">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(currentNav == "dashboard" ? "active" : "")" href="@dashboardUrl">
                            <i class="ti ti-layout-dashboard me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item mt-2 text-uppercase small px-3 text-muted">Nghiệp vụ</li>
                    <li class="nav-item">
                        <a class="nav-link @(currentNav == "requests" ? "active" : "")" href="@requestsUrl">
                            <i class="ti ti-inbox me-2"></i> Đơn đăng ký
                            @* Hiển thị badge chờ xử lý *@
                            @Html.Action("_PendingBadge", "Requests", new { area = "Reception" })
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentNav == "reception_appointments" ? "active" : "")" href="@appointmentsListUrl">
                            <i class="ti ti-calendar-event me-2"></i> Lịch hẹn
                        </a>
                    </li>
                    @* *** THÊM MENU XEM CA LÀM *** *@
                    <li class="nav-item">
                        <a class="nav-link @(currentNav == "reception_workshifts" ? "active" : "")" href="@viewWorkShiftsUrl">
                            <i class="ti ti-clock-hour-4 me-2"></i> Xem Ca làm BS
                        </a>
                    </li>
                    @* *** KẾT THÚC THÊM *** *@

                    @* Bỏ menu Create và Search nếu chưa có Controller/Action tương ứng *@
                    @*
                        <li class="nav-item">
                            <a class="nav-link @(currentNav == "create_appointment" ? "active" : "")" href="@createAppUrl">
                                <i class="ti ti-calendar-plus me-2"></i> Tạo lịch hẹn mới
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentNav == "search_patient" ? "active" : "")" href="@searchPatientUrl">
                                <i class="ti ti-search me-2"></i> Tra cứu bệnh nhân
                            </a>
                        </li>
                    *@

                    <li class="nav-item mt-2 text-uppercase small px-3 text-muted">Hệ thống</li>
                    <li class="nav-item">
                        <a class="nav-link" href="@siteHomeUrl">
                            <i class="ti ti-home-2 me-2"></i> Về trang người dùng
                        </a>
                    </li>
                    <li class="nav-item">
                        @using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a class="nav-link text-danger" href="javascript:document.getElementById('logoutForm').submit()">
                                <i class="ti ti-logout me-2"></i> Đăng xuất
                            </a>
                        }
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="admin-main flex-fill d-flex flex-column">
            @* Tái sử dụng Header/Footer của Admin hoặc tạo riêng nếu cần style khác *@
            @Html.Partial("~/Areas/Admin/Views/Shared/_HeaderAdmin.cshtml")

            <div class="admin-content container-fluid py-4">
                @if (TempData["ok"] != null)
                {<div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
                @if (TempData["error"] != null || TempData["err"] != null)
                {<div class="alert alert-danger alert-dismissible fade show" role="alert">@(TempData["error"] ?? TempData["err"])<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
                @if (TempData["warn"] != null)
                {<div class="alert alert-warning alert-dismissible fade show" role="alert">@TempData["warn"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
                @if (TempData["info"] != null)
                {<div class="alert alert-info alert-dismissible fade show" role="alert">@TempData["info"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}

                @RenderBody()
            </div>

            @Html.Partial("~/Areas/Admin/Views/Shared/_FooterAdmin.cshtml")
        </main>
    </div>

    @* Copy các link Script từ _LayoutAdmin *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/admin.js")"></script> @* Tái sử dụng admin.js *@
    @RenderSection("Scripts", required: false)
</body>
</html>
