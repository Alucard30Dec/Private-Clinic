@model Clinic.Areas.Reception.Controllers.ReceptionWorkShiftViewModel
@using Clinic.Models // For DayOfWeek enum
@using System.Globalization // For CultureInfo
@{
    // Layout defined in _ViewStart.cshtml
    ViewBag.Title = "Xem Ca làm việc Bác sĩ";
    ViewBag.Nav = "reception_workshifts"; // Correct Nav key for Reception layout

    var currentCulture = CultureInfo.CurrentCulture; // To get localized day names

    // *** SỬA LỖI: Xóa các biến không còn tồn tại trên Model ***
    // int? selectedDoctorId = Model.SelectedDoctorId; (Luôn là null theo logic Controller)
    // string selectedDoctorName = Model.SelectedDoctorName; (Thuộc tính đã bị xóa)
    // *** KẾT THÚC SỬA LỖI ***
}

<div class="container-fluid py-3">

    <h2 class="mb-3">@ViewBag.Title</h2>

    @* Section 1: Doctor List Table *@
    <h4>Danh sách Bác sĩ</h4>
    @if (Model.AllDoctors == null || !Model.AllDoctors.Any()) // Added null check
    {
        <div class="alert alert-warning">Không có bác sĩ nào trong hệ thống.</div>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Bác sĩ</th>
                        <th>Chuyên khoa</th> @* SỬA: Dùng Specialty.Name *@
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int doctorIndex = 1; }
                    @foreach (var doctor in Model.AllDoctors)
                    {
                        <tr>
                            <td>@(doctorIndex++)</td>
                            <td>@doctor.Name</td>
                            <td>@doctor.Specialty?.Name</td> @* SỬA: Dùng Specialty.Name *@
                            <td class="text-end text-nowrap">
                                @* SỬA TẠI ĐÂY:
                                    Logic Controller (Reception/WorkShiftsController) sẽ REDIRECT sang 'Details'
                                    nếu có 'doctorIdFilter'.
                                    Do đó, link này phải trỏ đến Action 'Details' thay vì 'Index'.
                                *@
                                <a href="@Url.Action("Details", "WorkShifts", new { area = "Reception", id = doctor.Id })"
                                   class="btn btn-sm btn-primary">
                                    <i class="ti ti-calendar-time me-1"></i> Xem Ca làm
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* *** SỬA LỖI: Xóa toàn bộ Section 2 (phần hiển thị ca làm) ***
        Vì Controller (Reception/WorkShiftsController) đã chuyển hướng (Redirect)
        sang trang "Details" để hiển thị ca làm. Trang Index này chỉ còn
        nhiệm vụ hiển thị danh sách bác sĩ (Section 1).
    *@

</div>
