@* === NHẬN MODEL LÀ DANH SÁCH BÁC SĨ TỪ HOME CONTROLLER === *@
@model IEnumerable<Clinic.Models.Doctor>

@{
    ViewBag.Title = "Home Page";

    // Hàm trợ giúp để lấy ảnh theo giới tính
    Func<string, string> GenderPhoto = (gender) =>
    {
        var g = (gender ?? "").Trim().ToLower();
        var path = g == "nữ"
            ? "~/Resources/images/team-image3.jpg"   // nữ
            : "~/Resources/images/team-image2.jpg";  // nam & mặc định
        return Url.Content(path);
    };

    // Lấy bác sĩ đầu tiên trong model để làm đại diện
    var featuredDoctor = Model.FirstOrDefault();
}

<section id="home" class="slider" data-stellar-background-ratio="0.5">
    <div class="container">
        <div class="row">

            <div class="owl-carousel owl-theme">
                <div class="item item-first">
                    <div class="caption">
                        <div class="col-md-offset-1 col-md-10">

                            <h3>Hãy để chúng tôi làm cuộc sống của bạn tốt đẹp hơn</h3>
                            <h1>Sống Khỏe Mạnh</h1>
                            <a href="#team" class="section-btn btn btn-default smoothScroll">Gặp gỡ Bác sĩ</a>

                        </div>
                    </div>
                </div>

                <div class="item item-second">
                    <div class="caption">

                        <div class="col-md-offset-1 col-md-10">
                            <h3>Chăm sóc sức khỏe toàn diện</h3>
                            <h1>Phong cách sống Mới</h1>

                            <a href="#about" class="section-btn btn btn-default btn-gray smoothScroll">Tìm hiểu thêm</a>
                        </div>
                    </div>
                </div>

                <div class="item item-third">

                    <div class="caption">
                        <div class="col-md-offset-1 col-md-10">
                            <h3>Tận tâm vì sức khỏe của bạn</h3>
                            <h1>Lợi ích Sức khỏe</h1>
                            <a href="#team" class="section-btn btn btn-default btn-blue smoothScroll">Đội ngũ của chúng tôi</a>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</section>


<section id="about">
    <div class="container">
        <div class="row">

            <div class="col-md-6 col-sm-6">
                <div class="about-info">
                    <h2 class="wow fadeInUp" data-wow-delay="0.6s">Chào mừng đến với <i class="fa fa-h-square"></i>ealth Center</h2>

                    @* === SỬA ĐỔI: Thay đổi nội dung giới thiệu === *@
                    <div class="wow fadeInUp" data-wow-delay="0.8s">
                        <p>Phòng khám của chúng tôi cam kết mang lại dịch vụ y tế chất lượng cao, tận tâm và chuyên nghiệp.</p>
                        <p>Với đội ngũ y bác sĩ giàu kinh nghiệm và trang thiết bị hiện đại, chúng tôi luôn đặt sức khỏe và sự an toàn của bạn lên hàng đầu. Hãy tin tưởng và lựa chọn chúng tôi.</p>
                    </div>
                    @* === KẾT THÚC SỬA ĐỔI === *@

                    @* Phần này đã được làm "động" (lấy bác sĩ đầu tiên) *@
                    @if (featuredDoctor != null)
                    {
                        <figure class="profile wow fadeInUp" data-wow-delay="1s">
                            <img src="@GenderPhoto(featuredDoctor.Gender)" class="img-responsive" alt="@featuredDoctor.Name">

                            <figcaption>
                                <h3>@featuredDoctor.Name</h3>
                                <p>@featuredDoctor.Specialty</p>
                            </figcaption>
                        </figure>
                    }

                </div>

            </div>

        </div>
    </div>
</section>


<section id="team" data-stellar-background-ratio="1" style="padding: 60px 0;">
    <div class="container">
        <div class="row">

            <div class="col-md-12">
                <div class="section-title">
                    <h2 class="wow fadeInUp" data-wow-delay="0.1s">Đội ngũ Bác sĩ</h2>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                // Dùng vòng lặp để hiển thị 3 bác sĩ từ Model
                foreach (var doctor in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="team-thumb wow fadeInUp" data-wow-delay="0.2s">

                            <a href="@Url.Action("Details","Doctors", new { id = doctor.Id })" title="Xem chi tiết @doctor.Name">
                                <img src="@GenderPhoto(doctor.Gender)" class="img-responsive" alt="@doctor.Name" />
                            </a>

                            <div class="team-info">
                                <h3 style="margin-bottom:6px;">
                                    <a href="@Url.Action("Details","Doctors", new { id = doctor.Id })">@doctor.Name</a>
                                </h3>
                                <p class="text-muted" style="margin-bottom:10px;">@doctor.Specialty</p>

                                <div class="team-contact-info" style="margin-bottom:10px;">
                                    @if (!string.IsNullOrWhiteSpace(doctor.PhoneNumber))
                                    {<p><i class="fa fa-phone"></i> @doctor.PhoneNumber</p>}
                                    @if (!string.IsNullOrWhiteSpace(doctor.Email))
                                    {<p><i class="fa fa-envelope-o"></i> <a href="mailto:@doctor.Email">@doctor.Email</a></p>}
                                </div>

                                <a class="section-btn btn btn-default"
                                   href="@Url.Action("Details","Doctors", new { id = doctor.Id })">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-12">
                    <p class="text-center">Chưa có thông tin bác sĩ để hiển thị.</p>
                </div>
            }

        </div>
    </div>
</section>