@{
    // Biến này không còn được sử dụng ở menu trái
    // vì "Doctors" và "Make an appointment" đều hiển thị cho tất cả mọi người.
    var isPatient = Request.IsAuthenticated && User.IsInRole("Patient");
}

<section class="navbar navbar-default navbar-static-top" role="navigation">
    <div class="container">
        <div class="navbar-header">
            <button class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon icon-bar"></span>
                <span class="icon icon-bar"></span>
                <span class="icon icon-bar"></span>

            </button>


            <a href="@Url.Action("Index","Home")" class="navbar-brand">
                <i class="fa fa-h-square"></i>ealth Center
            </a>
        </div>

        <div class="collapse navbar-collapse">
            <ul class="nav navbar-nav nav-left">

                @* --- Các link cũ (Home, About...) đã được ẩn đi (Đã đúng) --- *@
                @*
                    @if (!isPatient)
                    {
                        ... (code đã ẩn) ...
                    }
                *@


                @* --- LINK CHO KHÁCH VÀ BỆNH NHÂN --- *@

                @* Đây là link "Doctors".
                    Nó trỏ đến trang Index của DoctorsController (Views/Doctors/Index.cshtml).
                    Nó hiển thị cho TẤT CẢ MỌI NGƯỜI (cả khách và bệnh nhân).
                    Đây chính là logic bạn muốn.
                *@
                <li>@Html.ActionLink("Doctors", "Index", "Doctors")</li>


                @* Đây là link "Make an appointment".
                    Nó trỏ đến trang Index của AppointmentController (Views/Appointment/Index.cshtml).
                    Nó cũng hiển thị cho TẤT CẢ MỌI NGƯỜI.
                *@
                <li>@Html.ActionLink("Make an appointment", "Index", "Appointment")</li>
            </ul>

            <ul class="nav navbar-nav navbar-right nav-right">
                @* Chỗ này hiển thị "Đăng nhập" / "Xin chào" (Đã đúng) *@
                @Html.Partial("_LoginPartial")
            </ul>
        </div>
    </div>
</section>